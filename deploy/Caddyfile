# 独立部署模板。域名通过 SITE_DOMAIN 注入，Caddy 自动申请并续期 HTTPS 证书。
# API 与 WebSocket 统一由 /api 前缀转发到后端。
# www.<SITE_DOMAIN> 通过 301 跳转到主域名，两个域名都需要解析到服务器。

www.{$SITE_DOMAIN} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
    encode zstd gzip

    handle_path /api/* {
        reverse_proxy {$BACKEND_UPSTREAM:topic-selection-server:8000}
    }

    handle {
        root * /etc/caddy/dist
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output stdout
        format json
    }
}
