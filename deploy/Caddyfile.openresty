# OpenResty 网关模式：只提供内部 HTTP，证书、HTTPS 和域名跳转由 OpenResty 管理。
{
    servers {
        # 前端不发布宿主机端口，仅信任连接它的内网代理传来的来源信息。
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }
}

:3000 {
    encode zstd gzip

    handle_path /api/* {
        reverse_proxy {$BACKEND_UPSTREAM:topic-selection-server:8000}
    }

    handle {
        root * /etc/caddy/dist
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output stdout
        format json
    }
}
