# 部署前将本文件复制为 deploy/.env 并逐项填写。deploy/.env 已被 .gitignore 忽略。
# 域名必须已经完成备案、解析到本服务器，并且服务器安全组放行 80/443 端口。

# 必填（本系统备案域名）
SITE_DOMAIN=topic.lqlab.cn
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
SPRING_DATASOURCE_USERNAME=wts
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-password
SPRING_REDIS_PASSWORD=replace-with-a-long-random-password

# 可选：全新数据库首次启动时，若还没有任何管理员，后端会自动创建一次。
# 首次登录后应立即修改密码，然后建议清空这三行。
APP_BOOTSTRAP_ADMIN_ACCOUNT=
APP_BOOTSTRAP_ADMIN_NAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# 可选：邮件验证码服务。不配置则依赖验证码邮件的功能不可用。
SPRING_MAIL_HOST=smtp.qq.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# 可选：腾讯云智能体（AI 题目辅助检查）。不配置则 AI 功能不可用。
TXY_BOT_APP_KEY=
