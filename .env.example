# Spring profile
SPRING_PROFILES_ACTIVE=develop

# MySQL 8
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/work_topic_selection
SPRING_DATASOURCE_USERNAME=wts
SPRING_DATASOURCE_PASSWORD=replace-with-local-password

# Redis
SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_DATABASE=2
SPRING_REDIS_PASSWORD=

# Backend
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8000
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_WEBSOCKET_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional one-time bootstrap administrator. Leave all three empty to disable.
APP_BOOTSTRAP_ADMIN_ACCOUNT=
APP_BOOTSTRAP_ADMIN_NAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Optional mail service
SPRING_MAIL_HOST=smtp.qq.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Optional AI topic-review service
TXY_BOT_APP_KEY=
